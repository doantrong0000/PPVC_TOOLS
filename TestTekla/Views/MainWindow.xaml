<Window x:Class="TeklaApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tekla Tools 2025" 
        SizeToContent="WidthAndHeight"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundLightGreyBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" TextElement.Foreground="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <StackPanel Grid.Row="0" Margin="20,30,20,30">
                    <TextBlock Text="TEKLA TOOLS" Foreground="White" FontSize="20" FontWeight="Bold"/>
                </StackPanel>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="INSTANT ACTIONS" Foreground="#AAAAAA" FontSize="10" FontWeight="Bold" Margin="15,10,0,5"/>
                    <Button Name="btnDeleteCut" Content="Delete PartCuts" Style="{StaticResource SideMenuButtonStyle}" Click="BtnDeleteCut_Click" Foreground="White"/>
                    <Button Name="btnQuickDim" Content="Quick Dimension (Drawing)" Style="{StaticResource SideMenuButtonStyle}" Click="BtnQuickDim_Click" Foreground="White"/>
                  

                    <TextBlock Text="TOOLS WITH VIEW" Foreground="#AAAAAA" FontSize="10" FontWeight="Bold" Margin="15,20,0,5"/>
                    <Button Name="btnReadParams" Content="Parameters Explorer" Style="{StaticResource SideMenuButtonStyle}" Click="BtnReadParams_Click" Foreground="White"/>
                    <Button Name="btnAddAssembly" Content="Join Assembly" Style="{StaticResource SideMenuButtonStyle}" Click="BtnAddAssembly_Click" Foreground="White"/>
                    <Button Name="btnStepTag" Content="Step Tag (Beams &amp; Slabs)" Style="{StaticResource SideMenuButtonStyle}" Click="BtnStepTag_Click" Foreground="White"/>
                </StackPanel>

         
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" TextElement.Foreground="{StaticResource TextDarkBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderGreyBrush}" BorderThickness="0,0,0,1" Padding="25,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtCurrentTool" Text="Dashboard" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Page Content Container -->
            <ContentControl Grid.Row="1" x:Name="MainContentControl" Margin="10"/>
        </Grid>

    </Grid>
</Window>
