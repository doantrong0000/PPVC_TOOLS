<Window x:Class="TeklaApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tekla Tools 2025"
        WindowState="Normal"
        MinWidth="1000" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundLightGreyBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Toggle Bar -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundWhiteBrush}" BorderBrush="{StaticResource BorderGreyBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton x:Name="rbModel" Content="MODEL VIEW" Style="{StaticResource ToggleTabButtonStyle}" IsChecked="True" Checked="Mode_Checked"/>
                <RadioButton x:Name="rbDrawing" Content="DRAWING VIEW" Style="{StaticResource ToggleTabButtonStyle}" Checked="Mode_Checked"/>
            </StackPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" TextElement.Foreground="{DynamicResource TextLightBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <StackPanel Grid.Row="0" Margin="20,30,20,30">
                        <TextBlock Text="TEKLA TOOLS" Foreground="{DynamicResource TextLightBrush}" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- MODEL MENU -->
                    <StackPanel x:Name="pnlModelMenu" Grid.Row="1">
                        <!-- Model Features (Views) -->
                        <TextBlock Text="MODEL FEATURES" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="20,0,0,10"/>
                        <Button Name="btnRebarTools" Content="Rebar Tools" Style="{StaticResource SideMenuButtonStyle}" Click="BtnRebarTools_Click"/>
                        <Button Name="btnRebarRSQN" Content="Rebar Numbering" Style="{StaticResource SideMenuButtonStyle}" Click="BtnRebarRSQN_Click"/>
                        <Button Name="btnCastUnitTools" Content="Cast Unit Tools" Style="{StaticResource SideMenuButtonStyle}" Click="BtnCastUnitTools_Click"/>


                        <!-- Model Actions (Instant) -->
                        <TextBlock Text="QUICK ACTIONS" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="20,20,0,10"/>

                        <StackPanel Margin="20,10,20,0">
                            <TextBlock Text="Delete by ID/GUID:" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="txtDeleteId" Width="140" Height="28" Margin="0,0,5,0" VerticalContentAlignment="Center" Padding="5,0"/>
                                <Button Name="btnDeleteById" Content="Delete" Click="BtnDeleteById_Click" Background="{DynamicResource BackgroundWhiteBrush}" Foreground="{DynamicResource TextDarkBrush}" BorderThickness="0" Padding="15,0" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- DRAWING MENU -->
                    <StackPanel x:Name="pnlDrawingMenu" Grid.Row="1" Visibility="Collapsed">
                        <!-- Drawing Features (Views) -->
                        <TextBlock Text="DRAWING FEATURES" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="20,0,0,10"/>
                        <Button Name="btnRebarTagScanner" Content="Rebar Tag Scanner" Style="{StaticResource SideMenuButtonStyle}" Click="BtnRebarTagScanner_Click"/>

                        <!-- Drawing Actions (Instant) -->
                        <TextBlock Text="QUICK ACTIONS" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="20,20,0,10"/>
                        <Button Name="btnStepTag" Content="Step Tag (Beams/Slabs)" Style="{StaticResource SideMenuButtonStyle}" Click="BtnStepTag_Click"/>
                        <Button Name="btnOpeningX" Content="Opening Mark" Style="{StaticResource SideMenuButtonStyle}" Click="BtnOpeningX_Click"/>
                    </StackPanel>

                    <!-- Footer -->
                    <StackPanel Grid.Row="2" Margin="20,0,20,20">
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" Background="{DynamicResource BackgroundWhiteBrush}">
                <!-- Page Content Container -->
                <ContentControl x:Name="MainContentControl" Margin="10"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
