<Window x:Class="TeklaApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tekla Tools 2020"
        WindowState="Normal"
        MinWidth="1000" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7"
        Topmost="{Binding ElementName=btnTopmost, Path=IsChecked}"
        Icon="/Views/icon.ico">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ModernSwitchStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="50"/>
                <Setter Property="Height" Value="25"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <!-- Track Background -->
                                <Border x:Name="BackgroundBorder"
                                        Background="#DDDDDD"
                                        CornerRadius="12.5">
                                </Border>

                                <!-- Thumb Round Button -->
                                <Border x:Name="Dot"
                                        Width="21" Height="21"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="2,0,0,0"
                                        Background="White"
                                        CornerRadius="10.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- On State (IsChecked = True) -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="BackgroundBorder" Property="Background" Value="#4CD964"/>
                                    <!-- Green color -->
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Dot"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 To="25" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Dot"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 To="0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Toggle Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton x:Name="rbModel" Content="MODEL VIEW" Style="{StaticResource ToggleTabButtonStyle}" IsChecked="True" Checked="Mode_Checked"/>
                    <RadioButton x:Name="rbDrawing" Content="DRAWING VIEW" Style="{StaticResource ToggleTabButtonStyle}" Checked="Mode_Checked"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Always on Top" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#666666"/>
                    <ToggleButton x:Name="btnTopmost" Style="{StaticResource ModernSwitchStyle}" IsChecked="False" ToolTip="Always on Top" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="#1E2228" TextElement.Foreground="#FFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <StackPanel Grid.Row="0" Margin="20,30,20,30">
                        <TextBlock Text="TEKLA TOOLS" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- MODEL MENU -->
                    <StackPanel x:Name="pnlModelMenu" Grid.Row="1">
                        <!-- Model Features (Views) -->
                        <TextBlock Text="MODEL FEATURES" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="20,0,0,10"/>
                        <Button Name="btnRebarTools" Content="Rebar Tools" Style="{StaticResource SideMenuButtonStyle}" Click="BtnRebarTools_Click"/>
                        <Button Name="btnRebarRSQN" Content="Rebar Numbering" Style="{StaticResource SideMenuButtonStyle}" Click="BtnRebarRSQN_Click"/>
                        <Button Name="btnCastUnitTools" Content="Cast Unit Tools" Style="{StaticResource SideMenuButtonStyle}" Click="BtnCastUnitTools_Click"/>


                        <!-- Model Actions (Instant) -->
                        <TextBlock Text="QUICK ACTIONS" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="20,20,0,10"/>

                        <StackPanel Margin="20,10,20,0" x:Name="FindRebarPanel">
                            <!-- Assembly Filter -->
                            <TextBlock Text="ASSEMBLY FILTER:" Foreground="#CCCCCC" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="txtFindAsm" Text="{Binding FindAsm, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="28" Margin="0,0,5,0" VerticalContentAlignment="Center" TextAlignment="Center" FontWeight="Bold" ToolTip="Assembly Mark (Leave empty for all assemblies)"/>
                                <Button Name="btnPickAssembly" Click="BtnPickAssembly_Click" Content="Pick" Background="#FFFFFF" Foreground="#282C34" BorderThickness="0" Padding="15,0" FontWeight="Bold" ToolTip="Pick a part to get its assembly mark"/>
                            </StackPanel>

                            <!-- Find Seq -->
                            <TextBlock Text="FIND REBAR BY SEQ:" Foreground="#CCCCCC" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBox x:Name="txtFindSeq" Text="{Binding FindSeq, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="28" Margin="0,0,5,0" VerticalContentAlignment="Center" TextAlignment="Center" FontWeight="Bold" KeyDown="TxtFindSeq_KeyDown"/>
                                <Button Name="btnFindRebar" Click="BtnFindRebar_Click" Content="Find" Background="#FFFFFF" Foreground="#282C34" BorderThickness="0" Padding="15,0" FontWeight="Bold" ToolTip="Find and Select rebar in model by SEQ number"/>


                            </StackPanel>
                            <CheckBox Name="chkShowOnlyFound" Content="Show only" IsChecked="{Binding IsShowOnly}" VerticalAlignment="Center" Foreground="#CCCCCC" Margin="10,0,0,0" ToolTip="Hide other rebars when finding"/>
                            <TextBlock Name="txtSearchStatus" Text="{Binding StatusMessage}" Margin="0,5,0,0" FontSize="11" FontStyle="Italic" Foreground="#4CD964" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- DRAWING MENU -->
                    <StackPanel x:Name="pnlDrawingMenu" Grid.Row="1" Visibility="Collapsed">
                        <!-- Drawing Features (Views) -->
                        <TextBlock Text="DRAWING FEATURES" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="20,0,0,10"/>
                        <Button Name="btnRebarTagScanner" Content="Rebar Tag Scanner" Style="{StaticResource SideMenuButtonStyle}" Click="BtnRebarTagScanner_Click"/>
                        <Button Name="btnPPVCAutoDimTag" Content="PPVC Auto Dim Tag" Style="{StaticResource SideMenuButtonStyle}" Click="BtnPPVCAutoDimTag_Click"/>

                        <!-- Drawing Actions (Instant) -->
                        <TextBlock Text="QUICK ACTIONS" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="20,20,0,10"/>
                        <Button Name="btnStepTag" Content="Step Tag (Beams/Slabs)" Style="{StaticResource SideMenuButtonStyle}" Click="BtnStepTag_Click"/>
                        <Button Name="btnOpeningX" Content="Opening Mark" Style="{StaticResource SideMenuButtonStyle}" Click="BtnOpeningX_Click"/>
                    </StackPanel>

                    <!-- Footer -->
                    <StackPanel Grid.Row="2" Margin="20,0,20,20">
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" Background="#FFFFFF">
                <!-- Page Content Container -->
                <ContentControl x:Name="MainContentControl" Margin="10"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
