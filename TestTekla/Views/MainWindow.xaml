<Window x:Class="TeklaApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tekla Tools 2025" 
        WindowState="Maximized"
        MinWidth="1000" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundLightGreyBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar for INSTANT ACTIONS -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderGreyBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ INSTANT ACTIONS:" Foreground="{StaticResource PrimaryBlueBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Name="btnDeleteCut" Content="Delete PartCuts" Margin="0,0,10,0" Click="BtnDeleteCut_Click"/>
                    <Button Name="btnOpeningX" Content="Opening ✕" Margin="0,0,10,0" Click="BtnOpeningX_Click"/>
                    
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0"/>

                    <TextBlock Text="Delete by ID/GUID:" Foreground="#666" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtDeleteId" Width="100" Height="24" Margin="0,0,5,0" VerticalContentAlignment="Center" Padding="5,0"/>
                    <Button Name="btnDeleteById" Content="Delete Object" Margin="0,0,10,0" Click="BtnDeleteById_Click" Background="#FF3D00" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" TextElement.Foreground="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <StackPanel Grid.Row="0" Margin="20,30,20,30">
                        <TextBlock Text="TEKLA TOOLS" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Navigation Buttons -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="TOOLS WITH VIEW" Foreground="#AAAAAA" FontSize="10" FontWeight="Bold" Margin="15,0,0,5"/>
                        <Button Name="btnAddAssembly" Content="Assembly Joiner" Style="{StaticResource SideMenuButtonStyle}" Click="BtnAddAssembly_Click" Foreground="White"/>
                        <Button Name="btnStepTag" Content="Step Tag (Beams &amp; Slabs)" Style="{StaticResource SideMenuButtonStyle}" Click="BtnStepTag_Click" Foreground="White"/>
                        <Button Name="btnRebarTools" Content="Rebar Tools 🌟" Style="{StaticResource SideMenuButtonStyle}" Click="BtnRebarTools_Click" Foreground="White"/>
                        <Button Name="btnViewAlign" Content="View Align" Style="{StaticResource SideMenuButtonStyle}" Click="BtnViewAlign_Click" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="20,0,20,30">
                        <TextBlock Text="v1.0.0" Foreground="#666" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" TextElement.Foreground="{StaticResource TextDarkBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Header -->
                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderGreyBrush}" BorderThickness="0,0,0,1" Padding="25,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtCurrentTool" Text="Dashboard" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Page Content Container -->
                <ContentControl Grid.Row="1" x:Name="MainContentControl" Margin="10"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
