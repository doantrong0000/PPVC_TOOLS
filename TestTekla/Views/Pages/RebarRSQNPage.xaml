<UserControl x:Class="TeklaApp.Views.Pages.RebarRSQNPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="920">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundGreyBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + Action Bar -->
        <Border Grid.Row="0" Margin="10,10,10,5" Style="{StaticResource CardStyle}" Background="Transparent">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox x:Name="chkShowSelected" Content="SHOW ONLY"
                                  VerticalAlignment="Center" Margin="0,0,15,0"
                                  ToolTip="Filter grid to show only selected rows"/>
                        <Button Content="SELECT"
                                Click="BtnSelectInModel_Click" Focusable="False"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="100" Height="40"
                                Margin="0,0,8,0"/>
                        <Button Content="GET REBAR FROM MODEL"
                                Click="BtnGetRebar_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="200" Height="40"
                                ToolTip="Get selected rebars or rebars from selected part"/>

                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="REBAR SEQUENCE NUMBERING" Style="{StaticResource HeaderTextStyle}" Margin="0"/>

                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- DataGrid Area -->
            <Border Grid.Column="0" Grid.Row="0" Margin="10,5,5,5" Padding="0" Style="{StaticResource CardStyle}">
                <DataGrid x:Name="dgvRebar"
                          ItemsSource="{Binding Groups}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Extended"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="Black"
                          VerticalGridLinesBrush="Black"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="32"
                          SelectionChanged="DgvRebar_SelectionChanged"
                          MouseDoubleClick="DgvRebar_MouseDoubleClick">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F8F8"/>
                            <Setter Property="Foreground" Value="#666666"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E5E5E5"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="btnFilter" Grid.Column="1" Margin="5,0,0,0" Width="16" Height="16" Click="BtnFilter_Click" Background="Transparent" BorderThickness="0" Focusable="False">
                                                <TextBlock Text="▼" FontSize="8" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#666666"/>
                                            </ToggleButton>
                                        </Grid>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                            <Setter Property="Background" Value="{Binding ColorBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#0078D7"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mark" Binding="{Binding Mark}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="RSQN" Binding="{Binding Seq}" SortMemberPath="Seq" IsReadOnly="True" Width="Auto" MinWidth="100" MaxWidth="300" FontWeight="Bold" Foreground="Red"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="60" FontWeight="Bold" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Length" Binding="{Binding Length, StringFormat={}{0:F0}}" Width="80" FontWeight="Bold" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Shape" Binding="{Binding Shape}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Weight" Binding="{Binding Weight, StringFormat={}{0:F2}}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Check Agian" Binding="{Binding Checkagain}" Width="100" Foreground="Red" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Overlap" Binding="{Binding Overlap}" Width="100" Foreground="Red" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Selected Text Area -->
            <Border Grid.Column="0" Grid.Row="1" Margin="10,0,5,5" Style="{StaticResource CardStyle}" Background="Transparent" Padding="5" BorderThickness="0">
                <DockPanel>
                    <Button Content="SELECT ALL"
         Click="BtnSelectAll_Click" Focusable="False"
         Style="{StaticResource PrimaryButtonStyle}"
         Width="100" Height="40"
         Margin="0,0,8,0"/>
                    <TextBox x:Name="txtSelectedInfo" Height="40" TextWrapping="NoWrap" IsReadOnly="True" VerticalContentAlignment="Center"/>
                </DockPanel>
            </Border>

        </Grid>

        <!-- Filter Popup -->
        <Popup x:Name="filterPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="5" MinWidth="150" MaxHeight="300">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="5" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="txtFilterSearch" Grid.Row="0" Margin="2" Padding="2" TextChanged="TxtFilterSearch_TextChanged" />

                    <CheckBox x:Name="chkSelectAllFilter" Grid.Row="1" Margin="4,2" Content="(Select All)" IsChecked="True" Click="ChkSelectAllFilter_Click"/>

                    <ScrollViewer Grid.Row="2" Margin="0,5" VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="lstFilterItems" BorderThickness="0" ItemsSource="{Binding FilterItems}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayValue}" IsChecked="{Binding IsSelected}" Margin="2" Click="FilterItemCheckBox_Click"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button Content="OK" Click="BtnApplyFilter_Click" Width="60" Margin="0,0,5,0" Padding="2"/>
                        <Button Content="Cancel" Click="BtnCancelFilter_Click" Width="60" Padding="2"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
