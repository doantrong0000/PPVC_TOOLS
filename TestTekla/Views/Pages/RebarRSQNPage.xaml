<UserControl x:Class="TeklaApp.Views.Pages.RebarRSQNPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundGreyBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + Action Bar -->
        <Border Grid.Row="0" Margin="10,10,10,5" Style="{StaticResource CardStyle}">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="GET REBAR FROM MODEL"
                                Click="BtnGetRebar_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="200" Height="40" Margin="0,0,8,0"
                                ToolTip="Get selected rebars or rebars from selected part"/>
                        <Button Content="SELECT"
                                Click="BtnSelectInModel_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="100" Height="40"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="REBAR SEQUENCE NUMBERING (RSQN)" Style="{StaticResource HeaderTextStyle}" Margin="0"/>
                        <TextBlock Text="Legacy version (Group &amp; Compare)" FontSize="12" Foreground="#888888"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid Area -->
            <Border Grid.Column="0" Margin="10,5,5,5" Padding="0" Style="{StaticResource CardStyle}">
                <DataGrid x:Name="dgvRebar"
                          ItemsSource="{Binding Groups}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Extended"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="32"
                          MouseDoubleClick="DgvRebar_MouseDoubleClick">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F8F8"/>
                            <Setter Property="Foreground" Value="#666666"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E5E5E5"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                            <Setter Property="Background" Value="{Binding ColorBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#0078D7"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="100"/>
                        <DataGridTextColumn Header="Mark" Binding="{Binding Mark}" Width="80"/>
                        <DataGridTextColumn Header="RSQN" Binding="{Binding Seq}" Width="60" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="60"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="60"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50"/>
                        <DataGridTextColumn Header="Length" Binding="{Binding Length, StringFormat={}{0:F0}}" Width="80"/>
                        <DataGridTextColumn Header="Weight" Binding="{Binding Weight, StringFormat={}{0:F2}}" Width="80"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Control Panel Sidebar -->
            <StackPanel Grid.Column="1" Margin="5,5,10,5">
                <Border Style="{StaticResource CardStyle}" Padding="15">
                    <StackPanel>
                        <TextBlock Text="NUMBERING RSQN" FontWeight="Bold" FontSize="14" Margin="0,0,0,15" Foreground="{StaticResource PrimaryDarkBrush}"/>
                        
                        <RadioButton Content="Compare to old" 
                                     IsChecked="{Binding CompareToOld}" 
                                     Margin="0,0,0,10" FontSize="13"/>
                        <RadioButton Content="Renumber all" 
                                     IsChecked="{Binding RenumberAll}" 
                                     Margin="0,0,0,10" FontSize="13"/>
                        <RadioButton Content="Renumber selected" 
                                     IsChecked="{Binding RenumberSelected}" 
                                     Margin="0,0,0,15" FontSize="13"/>

                        <DockPanel Margin="0,0,0,20">
                            <TextBlock Text="Start numbering:" VerticalAlignment="Center" FontSize="12" Foreground="#666"/>
                            <TextBox Text="{Binding StartNumberStr, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="60" Height="30" HorizontalAlignment="Right" 
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     FontWeight="Bold"
                                     PreviewTextInput="NumberValidationTextBox"/>
                        </DockPanel>

                        <Button Content="CHANGE"
                                Click="BtnChange_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="40" Margin="0,0,0,10"/>

                        <Button Content="UPDATE IN MODEL"
                                Click="BtnUpdate_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="50"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="15" Background="#FFF8E1" BorderBrush="#FFE082">
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#856404">
                        <Bold>Instructions:</Bold><LineBreak/>
                        1. Select a part or rebars in Tekla.<LineBreak/>
                        2. Click 'GET REBAR' to load data.<LineBreak/>
                        3. Choose a numbering option and click 'CHANGE'.<LineBreak/>
                        4. Check 'Note' and 'Color' columns.<LineBreak/>
                        5. Click 'UPDATE IN MODEL' to save.
                    </TextBlock>
                </Border>
                
                <TextBlock Text="Developed by Digital team - WH Viet Nam" 
                           FontSize="10" Foreground="#AAA" 
                           Margin="0,20,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Footer - Status -->
        <Border Grid.Row="2" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{StaticResource PrimaryBorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status:" Foreground="#999" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
