<UserControl x:Class="TeklaApp.Views.Pages.RebarRSQNPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundGreyBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + Action Bar -->
        <Border Grid.Row="0" Margin="10,10,10,5" Style="{StaticResource CardStyle}" Background="Transparent">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox x:Name="chkShowSelected" Content="SHOW ONLY"
                                  VerticalAlignment="Center" Margin="0,0,15,0"
                                  Checked="ChkShowSelected_Checked" Unchecked="ChkShowSelected_Unchecked"
                                  ToolTip="Filter grid to show only selected rows"/>
                        <Button Content="SELECT"
                                Click="BtnSelectInModel_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="100" Height="40"
                                Margin="0,0,8,0"/>
                        <Button Content="GET REBAR FROM MODEL"
                                Click="BtnGetRebar_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="200" Height="40"
                                ToolTip="Get selected rebars or rebars from selected part"/>

                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="REBAR SEQUENCE NUMBERING" Style="{StaticResource HeaderTextStyle}" Margin="0"/>

                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- DataGrid Area -->
            <Border Grid.Column="0" Grid.Row="0" Margin="10,5,5,5" Padding="0" Style="{StaticResource CardStyle}">
                <DataGrid x:Name="dgvRebar"
                          ItemsSource="{Binding Groups}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Extended"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="Black"
                          VerticalGridLinesBrush="Black"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="32"
                          SelectionChanged="DgvRebar_SelectionChanged"
                          MouseDoubleClick="DgvRebar_MouseDoubleClick">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F8F8"/>
                            <Setter Property="Foreground" Value="#666666"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E5E5E5"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                            <Setter Property="Background" Value="{Binding ColorBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#0078D7"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mark" Binding="{Binding Mark}" Width="60"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                        <DataGridTextColumn Header="RSQN" Binding="{Binding SeqDisplay}" SortMemberPath="Seq" Width="Auto" MinWidth="100" MaxWidth="300" FontWeight="Bold" Foreground="Red"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="60" FontWeight="Bold" />
                        <DataGridTextColumn Header="Length" Binding="{Binding Length, StringFormat={}{0:F0}}" Width="80" FontWeight="Bold" />
                        <DataGridTextColumn Header="Shape" Binding="{Binding Shape}" Width="80"/>
                        <DataGridTextColumn Header="Weight" Binding="{Binding Weight, StringFormat={}{0:F2}}" Width="80"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50"/>
                        <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="60"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Selected Text Area -->
            <Border Grid.Column="0" Grid.Row="1" Margin="10,0,5,5" Style="{StaticResource CardStyle}" Background="Transparent" Padding="5" BorderThickness="0">
                <DockPanel>
                    <TextBlock Text="Selected Seqs:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="{StaticResource PrimaryDarkBrush}"/>
                    <TextBox x:Name="txtSelectedInfo" Height="30" TextWrapping="NoWrap" IsReadOnly="True" VerticalContentAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Control Panel Sidebar -->
            <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="5,5,10,5">
                <Border Style="{StaticResource CardStyle}" Padding="15">
                    <StackPanel>

                        <Button Content="FIND CHECK AGAIN"
                                Click="BtnFindCheckAgain_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="50" Margin="0,10,0,10" ToolTip="Run Check Again logic and sort to top"/>

                        <Button Content="FIND OVERLAP"
                                Click="BtnFindOverlap_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="50" Margin="0,10,0,10" ToolTip="Run Overlap logic and sort to top"/>

                    </StackPanel>
                </Border>

                <TextBlock Text="Developed by Digital team - WH Viet Nam"
                           FontSize="10" Foreground="#AAA"
                           Margin="0,20,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Update by Trong"
                           FontSize="10" Foreground="#AAA"
                           Margin="0,20,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
