<UserControl x:Class="TeklaApp.Views.Pages.ViewAlignPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundLightGreyBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="10,10,10,5" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="VIEW ALIGN" Style="{StaticResource HeaderTextStyle}" Margin="0"/>
                <TextBlock Text="Pick reference point → Pick objects → Align to selected axis coordinates." 
                           FontSize="11" Foreground="#AAAAAA" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Margin="10,5,10,5" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Card 1: Chọn trục Align -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="1. ALIGN AXIS" FontWeight="Bold" FontSize="12" Foreground="#222" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                            <RadioButton x:Name="rbAxisX" Content="  X  (East–West)" GroupName="Axis" 
                                         Margin="0,0,20,0" FontSize="12" VerticalContentAlignment="Center" Cursor="Hand"/>
                            <RadioButton x:Name="rbAxisY" Content="  Y  (North–South)" GroupName="Axis" 
                                         Margin="0,0,20,0" FontSize="12" VerticalContentAlignment="Center" Cursor="Hand"/>
                            <RadioButton x:Name="rbAxisZ" Content="  Z  (Elevation)" GroupName="Axis" IsChecked="True"
                                         Margin="0,0,0,0" FontSize="12" VerticalContentAlignment="Center" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 2: Chế độ Align -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="2. ALIGN MODE" FontWeight="Bold" FontSize="12" Foreground="#222" Margin="0,0,0,8"/>

                        <RadioButton x:Name="rbModeEditPoints" GroupName="Mode" IsChecked="True" 
                                     Margin="5,0,0,8" FontSize="12" VerticalContentAlignment="Top" Cursor="Hand">
                            <StackPanel Margin="5,0,0,0">
                                <TextBlock Text="Edit Points – Modify individual polygon points" FontWeight="SemiBold"/>
                                <TextBlock Text="Moves all polygon points (rebar shape) to the same axis coordinate. Use to flatten rebar shapes." 
                                           FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="rbModeMoveObject" GroupName="Mode" 
                                     Margin="5,0,0,0" FontSize="12" VerticalContentAlignment="Top" Cursor="Hand">
                            <StackPanel Margin="5,0,0,0">
                                <TextBlock Text="Move Object – Move entire object" FontWeight="SemiBold"/>
                                <TextBlock Text="Moves the entire object (Part/Rebar) to the reference coordinate. Keeps shape intact, only changes placement." 
                                           FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Card 3: Hướng dẫn nhanh -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="📋 INSTRUCTIONS" FontWeight="Bold" FontSize="12" Foreground="#222" Margin="0,0,0,6"/>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock FontSize="11" Foreground="#555" Margin="0,0,0,4">
                                <Run FontWeight="SemiBold">Step 1:</Run>
                                <Run> Select axis (X/Y/Z) and align mode above.</Run>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="#555" Margin="0,0,0,4">
                                <Run FontWeight="SemiBold">Step 2:</Run>
                                <Run> Click RUN ALIGN → Pick 1 reference point in Tekla.</Run>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="#555" Margin="0,0,0,4">
                                <Run FontWeight="SemiBold">Step 3:</Run>
                                <Run> Pick objects (Rebar/Part) to align.</Run>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="#555" Margin="0,0,0,0">
                                <Run FontWeight="SemiBold">Step 4:</Run>
                                <Run> Press Middle Mouse Button to finish.</Run>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 4: Kết quả lần chạy gần nhất -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,5" Padding="10">
                    <StackPanel>
                        <TextBlock Text="📊 RESULT LOG" FontWeight="Bold" FontSize="12" Foreground="#222" Margin="0,0,0,6"/>
                        <Border Background="#FAFAFA" CornerRadius="4" Padding="10" MinHeight="40">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Reference Point: " FontSize="11" Foreground="#888"/>
                                    <TextBlock x:Name="txtRefPoint" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlueBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Aligned Objects: " FontSize="11" Foreground="#888"/>
                                    <TextBlock x:Name="txtAlignedCount" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlueBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="txtResultMessage" Text="Ready: Configure options and click RUN." 
                                           FontSize="11" Foreground="#777" FontStyle="Italic" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer / Action Bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderGreyBrush}" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Status:" Foreground="#999" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtStatus" Text="Ready" Foreground="{StaticResource PrimaryBlueBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnRun" Grid.Column="1" 
                        Content="▶  RUN ALIGN" 
                        Click="BtnRun_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="150" Height="36" FontSize="13"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
