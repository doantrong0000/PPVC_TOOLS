<UserControl x:Class="TeklaApp.Views.ParameterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="2"/>
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Margin" Value="2,0,0,0"/>
                <Setter Property="Background" Value="#F8F9FA"/>
            </Style>

            <Style x:Key="FieldHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#666666"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>

            <Style x:Key="AreaTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource HeaderTextStyle}">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Background="{StaticResource BackgroundLightGreyBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Padding="25,15" Background="White" BorderBrush="{StaticResource BorderGreyBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="PARAMETER MANAGER" Style="{StaticResource HeaderTextStyle}" Margin="0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Symmetric Sync Mode" VerticalAlignment="Center" Foreground="#888" FontSize="11" FontStyle="Italic"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="20" Padding="25">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Titles -->
                    <RowDefinition Height="Auto"/> <!-- Select Buttons -->
                    <RowDefinition Height="Auto"/> <!-- Object Names -->
                    <RowDefinition Height="25"/>   <!-- Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Field 1 -->
                    <RowDefinition Height="Auto"/> <!-- Field 2 -->
                    <RowDefinition Height="Auto"/> <!-- Field 3 -->
                    <RowDefinition Height="Auto"/> <!-- Field 4 -->
                    <RowDefinition Height="*"/>    <!-- Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Save Button -->
                </Grid.RowDefinitions>

                <!-- ROW 0: TITLES -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="SOURCE OBJECT (A)" Style="{StaticResource AreaTitleStyle}" Foreground="{StaticResource PrimaryBlueBrush}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="TARGET OBJECT (B)" Style="{StaticResource AreaTitleStyle}" Foreground="#28A745"/>

                <!-- ROW 1: SELECT BUTTONS -->
                <Button Grid.Row="1" Grid.Column="0" Content="SELECT OBJECT A" Height="35" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}" Click="BtnPick1_Click"/>
                <Button Grid.Row="1" Grid.Column="2" Content="SELECT OBJECT B" Height="35" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="BtnPick2_Click" Background="#28A745"/>

                <!-- ROW 2: OBJECT NAMES -->
                <Border Grid.Row="2" Grid.Column="0" Background="#F8F9FA" Padding="10,6" CornerRadius="4" Margin="0,10,10,0" BorderBrush="#EEEEEE" BorderThickness="1">
                    <TextBlock Text="{Binding Object1Name}" FontSize="11" Foreground="#444" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" Background="#F8F9FA" Padding="10,6" CornerRadius="4" Margin="10,10,0,0" BorderBrush="#EEEEEE" BorderThickness="1">
                    <TextBlock Text="{Binding Object2Name}" FontSize="11" Foreground="#444" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                </Border>

                <!-- MIDDLE COLUMN BUTTONS (COPY ALL) -->
                <StackPanel Grid.Row="4" Grid.RowSpan="4" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Content="→" ToolTip="Sync All Fields A to B" Click="BtnCopyAll_Click" Width="50" Height="42" FontSize="18" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}"/>
                    <TextBlock Text="COPY ALL" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0" FontWeight="Bold" Foreground="#999"/>
                </StackPanel>

                <!-- FIELD ROWS -->
                <!-- Field 1 -->
                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,15,18">
                    <TextBlock Text="USER_FIELD_1" Style="{StaticResource FieldHeaderStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Field1_1, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Content="SEL" ToolTip="Apply to current selection" Style="{StaticResource ActionButtonStyle}" Click="BtnApply1_Selected_Click"/>
                            <Button Content="PICK" ToolTip="Pick target objects" Style="{StaticResource ActionButtonStyle}" Click="BtnApply1_Pick_Click"/>
                            <Button Content="→" ToolTip="Copy to B" Style="{StaticResource ActionButtonStyle}" Click="BtnCopy1_Click" Width="25" Background="#E3F2FD"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="15,0,0,18">
                    <TextBlock Text="USER_FIELD_1" Style="{StaticResource FieldHeaderStyle}"/>
                    <TextBox Text="{Binding Field1_2, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Field 2 -->
                <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,15,18">
                    <TextBlock Text="USER_FIELD_2" Style="{StaticResource FieldHeaderStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Field2_1, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Content="SEL" ToolTip="Apply to current selection" Style="{StaticResource ActionButtonStyle}" Click="BtnApply2_Selected_Click"/>
                            <Button Content="PICK" ToolTip="Pick target objects" Style="{StaticResource ActionButtonStyle}" Click="BtnApply2_Pick_Click"/>
                            <Button Content="→" ToolTip="Copy to B" Style="{StaticResource ActionButtonStyle}" Click="BtnCopy2_Click" Width="25" Background="#E3F2FD"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="2" Margin="15,0,0,18">
                    <TextBlock Text="USER_FIELD_2" Style="{StaticResource FieldHeaderStyle}"/>
                    <TextBox Text="{Binding Field2_2, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Field 3 -->
                <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,15,18">
                    <TextBlock Text="USER_FIELD_3" Style="{StaticResource FieldHeaderStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Field3_1, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Content="SEL" ToolTip="Apply to current selection" Style="{StaticResource ActionButtonStyle}" Click="BtnApply3_Selected_Click"/>
                            <Button Content="PICK" ToolTip="Pick target objects" Style="{StaticResource ActionButtonStyle}" Click="BtnApply3_Pick_Click"/>
                            <Button Content="→" ToolTip="Copy to B" Style="{StaticResource ActionButtonStyle}" Click="BtnCopy3_Click" Width="25" Background="#E3F2FD"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="2" Margin="15,0,0,18">
                    <TextBlock Text="USER_FIELD_3" Style="{StaticResource FieldHeaderStyle}"/>
                    <TextBox Text="{Binding Field3_2, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Field 4 -->
                <StackPanel Grid.Row="7" Grid.Column="0" Margin="0,0,15,18">
                    <TextBlock Text="USER_FIELD_4" Style="{StaticResource FieldHeaderStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Field4_1, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Content="SEL" ToolTip="Apply to current selection" Style="{StaticResource ActionButtonStyle}" Click="BtnApply4_Selected_Click"/>
                            <Button Content="PICK" ToolTip="Pick target objects" Style="{StaticResource ActionButtonStyle}" Click="BtnApply4_Pick_Click"/>
                            <Button Content="→" ToolTip="Copy to B" Style="{StaticResource ActionButtonStyle}" Click="BtnCopy4_Click" Width="25" Background="#E3F2FD"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="7" Grid.Column="2" Margin="15,0,0,18">
                    <TextBlock Text="USER_FIELD_4" Style="{StaticResource FieldHeaderStyle}"/>
                    <TextBox Text="{Binding Field4_2, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- SAVE BUTTON -->
                <Button Grid.Row="9" Grid.Column="2" Content="SAVE CHANGES TO TARGET (B)" Height="45" Margin="15,15,0,0"
                        Style="{StaticResource PrimaryButtonStyle}" Click="BtnSave2_Click" Background="#28A745"/>
            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderGreyBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="System Status:" Foreground="#999" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryBlueBrush}" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
