<UserControl x:Class="TeklaApp.Views.Pages.RebarNumberingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             HorizontalAlignment="Center">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top" HorizontalAlignment="Left" Width="400" Padding="20">
            <StackPanel>
                <TextBlock Text="REBAR NUMBERING (REVIT STYLE)" Foreground="{StaticResource PrimaryBlueBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>
                
                <TextBlock Text="1. Auto-Orientation Prefix" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="Analyze rebar direction and assign H or V to the Prefix field based on host orientation rules." 
                           TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,10"/>
                <Button Content="Auto-Assign H/V Prefix"  Style="{StaticResource PrimaryButtonStyle}" Height="35" Margin="0,0,0,25" Click="BtnAutoPrefix_Click" />

                <TextBlock Text="2. Sequence Numbering" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="Group rebars by Shape, Size, Grade, and Prefix, then assign unique sequence numbers." 
                           TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Start Number:" VerticalAlignment="Center" Width="100"/>
                    <TextBox Grid.Column="1" Text="{Binding StartingNumber}" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
                </Grid>

                <Button Content="RUN REBAR NUMBERING" Click="BtnRun_Click" 
                        Style="{StaticResource PrimaryButtonStyle}" Height="35" FontSize="14"/>

                <Border Background="#F0F7FF" CornerRadius="4" Margin="0,20,0,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="#0056b3" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#333" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Note: This writes to the 'REBAR_SEQUENCE_NUMBER' UDA." 
                           Foreground="#999" FontSize="10" Margin="0,15,0,0" FontStyle="Italic" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
