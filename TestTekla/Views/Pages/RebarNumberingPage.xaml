<UserControl x:Class="TeklaApp.Views.Pages.RebarNumberingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="600" Padding="15">
            <StackPanel>
                <TextBlock Text="REBAR NUMBERING (REVIT STYLE)" Foreground="{StaticResource PrimaryBlueBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <TextBlock Text="1. Auto-Orientation Prefix" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="Analyze rebar direction and assign H or V to the Prefix field based on host orientation rules." 
                           TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,5"/>
                
                <TextBlock Text="Keywords for Part Types (comma-separated):" FontWeight="Bold" FontSize="11" Margin="0,5,0,5"/>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Slab:" VerticalAlignment="Center" FontSize="11"/>
                    <TextBox Grid.Column="1" Text="{Binding SlabKeywords}" Height="22" Padding="2,0"/>
                </Grid>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Beam:" VerticalAlignment="Center" FontSize="11"/>
                    <TextBox Grid.Column="1" Text="{Binding BeamKeywords}" Height="22" Padding="2,0"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Wall:" VerticalAlignment="Center" FontSize="11"/>
                    <TextBox Grid.Column="1" Text="{Binding WallKeywords}" Height="22" Padding="2,0"/>
                </Grid>

                <Button Content="Auto-Assign H/V Prefix"  Style="{StaticResource PrimaryButtonStyle}" Height="30" Margin="0,0,0,15" Click="BtnAutoPrefix_Click" />

                <TextBlock Text="2. Assign Color (Class) by Size" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="Set rebar Class based on its diameter to manage visual representation." 
                           TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,5"/>

                <DataGrid ItemsSource="{Binding SizeColorTable}" AutoGenerateColumns="False" CanUserAddRows="True" 
                          Height="120" Margin="0,5,0,10" Background="White" BorderBrush="#DDD"
                          SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rebar Size" Binding="{Binding RebarSize}" Width="*"/>
                        <DataGridTextColumn Header="Class (Color)" Binding="{Binding RebarClass}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Content="Set Color by Size"  Style="{StaticResource PrimaryButtonStyle}" Height="30" Margin="0,0,0,15" Click="BtnColorBySize_Click" 
                        Background="#28a745" BorderBrush="#28a745"/>

                <TextBlock Text="3. Sequence Numbering" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="Group rebars by Shape, Size, Grade, and Prefix, then assign unique sequence numbers." 
                           TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,5"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Start Number:" VerticalAlignment="Center" Width="90"/>
                    <TextBox Grid.Column="1" Text="{Binding StartingNumber}" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
                </Grid>

                <Button Content="RUN REBAR NUMBERING" Click="BtnRun_Click" 
                        Style="{StaticResource PrimaryButtonStyle}" Height="36" FontSize="13"/>

                <Border Background="#F0F7FF" CornerRadius="4" Margin="0,15,0,0" Padding="10">
                    <StackPanel>
                        <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="#0056b3" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#333" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Note: This writes to 'REBAR_SEQ_NO' (Numbering) and 'Class' (Color)." 
                           Foreground="#999" FontSize="10" Margin="0,15,0,0" FontStyle="Italic" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
