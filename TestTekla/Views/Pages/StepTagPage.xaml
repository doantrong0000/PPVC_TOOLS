<UserControl x:Class="TeklaApp.Views.StepTagPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Settings Panel -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,20,0" VerticalAlignment="Top">
            <ScrollViewer Padding="0 0 10 0">
                <StackPanel>
                    <TextBlock Text="Step Tag Configuration" Style="{StaticResource HeaderTextStyle}" FontSize="16" Margin="0,0,0,15"/>

                    <TextBlock Text="TEXT PARAMETERS" FontWeight="Bold" Foreground="#999" FontSize="10" Margin="0,10,0,8"/>

                    <TextBlock Text="Font Height:" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Name="txtTextHeight" Text="3.5" Margin="0,0,0,12" TextChanged="OnSettingChanged"/>

                    <TextBlock Text="Font Name:" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Name="txtFontName" Text="Arial" Margin="0,0,0,12"/>

                    <TextBlock Text="GEOMETRY PARAMETERS" FontWeight="Bold" Foreground="#999" FontSize="10" Margin="0,10,0,8"/>

                    <TextBlock Text="Surface Length (mm):" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Name="txtSurfLen" Text="15" Margin="0,0,0,12" TextChanged="OnSettingChanged"/>

                    <TextBlock Text="Step Height (mm):" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Name="txtStepHeight" Text="10" Margin="0,0,0,12" TextChanged="OnSettingChanged"/>

                    <TextBlock Text="HATCH PARAMETERS" FontWeight="Bold" Foreground="#999" FontSize="10" Margin="0,10,0,8"/>

                    <TextBlock Text="Spacing:" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Name="txtHatchSpc" Text="3" Margin="0,0,0,12" TextChanged="OnSettingChanged"/>

                    <TextBlock Text="Length / Depth:" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Name="txtHatchLen" Text="12" Margin="0,0,0,12" TextChanged="OnSettingChanged"/>

                    <CheckBox Name="chkUseRectFill" Content="Use Rectangle Pattern Fill" Margin="0,5,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

                    <TextBlock Text="Pattern Name (e.g. ANSI31_13):" Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Name="txtFillName" Text="ANSI31_13" Margin="0,0,0,15" TextChanged="OnSettingChanged"/>

                  

                    <Border Background="#F8F8F8" CornerRadius="4" Margin="0,15,0,0" Padding="10">
                        <TextBlock Name="txtStatus" Text="Ready" TextWrapping="Wrap" Foreground="#444" FontSize="11" FontStyle="Italic"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
         
        </Border>

        <!-- Right: Visual Preview Area -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="#F0F0F0" CornerRadius="4">
                    <Viewbox Stretch="Uniform" Margin="20">
                        <Canvas Name="previewCanvas" Width="400" Height="300" ClipToBounds="True"/>
                    </Viewbox>
                </Border>

                <Button Margin="10" Grid.Row="1" Width="200" Content="RUN GENERATION" Height="45" Click="BtnRun_Click" Style="{DynamicResource PrimaryButtonStyle}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
