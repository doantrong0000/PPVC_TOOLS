<UserControl x:Class="TeklaApp.Views.Pages.PPVCAutoDimTagPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <CollectionViewSource x:Key="DimPropertiesCollection" Source="{Binding AvailableDimProperties}"/>
            <CollectionViewSource x:Key="TagPropertiesCollection" Source="{Binding AvailableTagProperties}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PPVC Auto Dim Tag" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
            <StackPanel>
                <!-- Rebar Dimension Mapping -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Rebar Dimension Mapping" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Profile:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Name="cmbProfiles" Width="150" Height="32" Margin="0,0,10,0" ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding SelectedProfile}" />
                        <Button Name="btnSaveProfile" Content="Save" Width="80" Height="32" Margin="0,0,10,0" Click="BtnSaveProfile_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="0"/>
                        <TextBox Name="txtSaveAs" Width="150" Height="32" VerticalContentAlignment="Center" Margin="0,0,10,0" Padding="5,0"/>
                        <Button Name="btnSaveAsProfile" Content="Save As" Width="80" Height="32" Margin="0,0,15,0" Click="BtnSaveAsProfile_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="0"/>
                        <Button Name="btnDeleteProfile" Content="Delete Profile" Width="100" Height="32" Margin="0,0,15,0" Click="BtnDeleteProfile_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="0"/>
                        <Button Name="btnAddRow" Content="Add Row" Width="90" Height="32" Margin="0,0,10,0" Click="BtnAddRow_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="0"/>
                        <Button Name="btnDeleteRow" Content="Delete Row" Width="90" Height="32" Click="BtnDeleteRow_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="0"/>
                    </StackPanel>

                    <DataGrid Name="dgMappingRules" ItemsSource="{Binding DimMappingRules}" AutoGenerateColumns="False" CanUserAddRows="True" Margin="0,0,0,10" Height="150" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rebar Name" Binding="{Binding RebarName}" Width="150"/>
                            <DataGridTextColumn Header="Number (V/H)" Binding="{Binding Prefix}" Width="100"/>
                            <DataGridComboBoxColumn Header="Tag Type" 
                                                    SelectedValueBinding="{Binding DimProperty}" 
                                                    ItemsSource="{Binding Source={StaticResource DimPropertiesCollection}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Name="btnAutoDimView" Content="Auto Dim View" Width="140" Height="36" Click="BtnAutoDimView_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                    <TextBlock Text="• Auto Dim View: Select a view first — auto finds all rebars and dimensions them based on the mapping rules above." Foreground="#888" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Separator -->
                <Separator Margin="0,15,0,15" Background="#DDDDDD"/>

                <!-- Rebar Tag Mapping -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Rebar Tag Mapping (Tekla Native Tag)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Tag Profile:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Name="cmbTagProfiles" Width="150" Height="32" Margin="0,0,10,0" ItemsSource="{Binding AvailableTagProfiles}" SelectedItem="{Binding SelectedTagProfile}" />
                        <Button Name="btnSaveTagProfile" Content="Save" Width="80" Height="32" Margin="0,0,10,0" Click="BtnSaveTagProfile_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="0"/>
                        <TextBox Name="txtTagSaveAs" Width="150" Height="32" VerticalContentAlignment="Center" Margin="0,0,10,0" Padding="5,0"/>
                        <Button Name="btnSaveAsTagProfile" Content="Save As" Width="80" Height="32" Margin="0,0,15,0" Click="BtnSaveAsTagProfile_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="0"/>
                        <Button Name="btnDeleteTagProfile" Content="Delete Profile" Width="100" Height="32" Margin="0,0,15,0" Click="BtnDeleteTagProfile_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="0"/>
                        <Button Name="btnAddTagRow" Content="Add Row" Width="90" Height="32" Margin="0,0,10,0" Click="BtnAddTagRow_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="0"/>
                        <Button Name="btnDeleteTagRow" Content="Delete Row" Width="90" Height="32" Click="BtnDeleteTagRow_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="0"/>
                    </StackPanel>

                    <DataGrid Name="dgTagMappingRules" ItemsSource="{Binding TagMappingRules}" AutoGenerateColumns="False" CanUserAddRows="True" Margin="0,0,0,10" Height="150" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rebar Name" Binding="{Binding RebarName}" Width="150"/>
                            <DataGridTextColumn Header="Number (V/H)" Binding="{Binding Prefix}" Width="100"/>
                            <DataGridComboBoxColumn Header="Tag Attribute" 
                                                    SelectedValueBinding="{Binding TagProperty}" 
                                                    ItemsSource="{Binding Source={StaticResource TagPropertiesCollection}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Name="btnAutoTagView" Content="Auto Tag View" Width="140" Height="36" Click="BtnAutoTagView_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                    <TextBlock Text="• Auto Tag View: Select a view first — auto finds all rebars and creates Tekla native tags (Marks) based on the mapping rules above." Foreground="#888" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#F8F8F8" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,5" Margin="-20,0,-20,-20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status:" Foreground="#999" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="11"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#005A9E" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

