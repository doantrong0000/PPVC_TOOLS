<UserControl x:Class="TeklaApp.Views.Pages.PPVCAutoDimTagPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PPVC Auto Dim Tag" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="0" HorizontalAlignment="Right" Name="txtStatus" Text="Ready." VerticalAlignment="Center" Foreground="#666"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Settings:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Name="txtSettings" Text="+ZRB_PPVC_CASTUNIT_DWG" Width="180" Height="28" VerticalContentAlignment="Center" Margin="0,0,15,0" Padding="5,0"/>
            <Button Name="btnCreateCastUnitDrawing" Content="Create Cast Unit Drawing" Width="200" Height="36" Margin="0,0,10,0" Click="BtnCreateCastUnitDrawing_Click" Style="{DynamicResource PrimaryButtonStyle}"/>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="Select the main part of the cast unit, then click the button above to generate its drawing." Foreground="#888" VerticalAlignment="Top" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,15,0,15">
            <Button Name="btnCreateSections" Content="Create 3 Basic Sections" Width="200" Height="36" Margin="0,0,10,0" Click="BtnCreateSections_Click" Style="{DynamicResource PrimaryButtonStyle}"/>
        </StackPanel>
        
        <TextBlock Grid.Row="4" Text="Open the generated Cast Unit Drawing, select an elevation view, then click the button above to cut Sàn, Tường, Mái sections." Foreground="#888" VerticalAlignment="Top" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
