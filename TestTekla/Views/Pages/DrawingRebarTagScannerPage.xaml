<UserControl x:Class="TeklaApp.Views.Pages.DrawingRebarTagScannerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Drawing Rebar Tag Scanner" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="0" HorizontalAlignment="Right" Name="txtStatus" Text="Ready." VerticalAlignment="Center" Foreground="#666"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Name="btnScan" Content="Scan Active Drawing" Width="180" Height="36" Margin="0,0,10,0" Click="BtnScan_Click" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button Name="btnExport" Content="Export JSON for AI" Width="150" Height="36" Click="BtnExport_Click" Background="White" Foreground="Black" FontWeight="Bold" BorderThickness="1" BorderBrush="#007ACC"/>
        </StackPanel>

        <DataGrid Grid.Row="2" Name="dgData" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding ScannedData}"
                  Background="#F7F9FC" RowBackground="White" AlternatingRowBackground="#F0F4F8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Rebar ID" Binding="{Binding RebarId}" Width="100"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="100"/>
                <DataGridTextColumn Header="Tags Count" Binding="{Binding TagCount}" Width="80"/>
                <DataGridTextColumn Header="View / Section" Binding="{Binding ViewName}" Width="150"/>
                <DataGridTextColumn Header="Tags Summary" Binding="{Binding TagSummary}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
