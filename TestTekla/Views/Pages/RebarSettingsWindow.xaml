<Window x:Class="TeklaApp.Views.Pages.RebarSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rebar Manager Settings" Height="500" Width="450"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#F5F5F5">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- General Settings -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="GENERAL SETTINGS" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,10"/>
                
                <CheckBox x:Name="chkUseExclusion" Content="Enable Name Exclusion" ToolTip="Exclude rebars with specific names from Auto Name / Auto V/H" Margin="0,0,0,5"/>
                <TextBlock Text="Exclude Names (comma separated):" FontSize="11" Foreground="#666"/>
                <TextBox x:Name="txtExcludeNames" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,5,0,15" IsEnabled="{Binding IsChecked, ElementName=chkUseExclusion}"/>

                <TextBlock Text="Structural Component Keywords:" FontWeight="Bold" FontSize="11" />
                <Grid Margin="0,5,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Slab:" VerticalAlignment="Center" FontSize="11"/>
                    <TextBox x:Name="txtSlabKeywords" Grid.Column="1" Height="22" Padding="2,0"/>
                </Grid>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Beam:" VerticalAlignment="Center" FontSize="11"/>
                    <TextBox x:Name="txtBeamKeywords" Grid.Column="1" Height="22" Padding="2,0"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Wall:" VerticalAlignment="Center" FontSize="11"/>
                    <TextBox x:Name="txtWallKeywords" Grid.Column="1" Height="22" Padding="2,0"/>
                </Grid>

                <Border Margin="0,15,0,0" Padding="0,10,0,0" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Overlap Length Tolerance:" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtOverlapTolerance" Grid.Column="1" Height="22" Padding="2,0" Margin="8,0,5,0"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" FontSize="11" Foreground="#888"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Color Class Mapping Table -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="10">
            <StackPanel>
                <TextBlock Text="AUTO COLOR: CLASS MAPPING" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="Set rebar Class based on its diameter." Foreground="#666" FontSize="11" Margin="0,0,0,10"/>
                
                <DataGrid x:Name="dgSizeColor" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                          Background="White" BorderBrush="#EEEEEE" BorderThickness="1" RowHeight="25"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rebar Size" Binding="{Binding RebarSize}" Width="*"/>
                        <DataGridTextColumn Header="Class (Color)" Binding="{Binding RebarClass}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Border Grid.Row="2" Background="Transparent" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="BtnCancel_Click" Width="80" Height="36" Margin="0,0,10,0" Background="#EEEEEE" BorderBrush="#CCCCCC" Foreground="#333"/>
                <Button Content="Save Settings" Click="BtnSave_Click" Width="120" Height="36" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

