<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
	  <TargetFramework>net48</TargetFramework>
    <Configurations>Debug T20;Debug T25;Release T20;Release T25</Configurations>
  </PropertyGroup>

  <!-- Cấu hình cho Tekla 2020 -->
  <PropertyGroup Condition="$(Configuration.Contains('T20'))">
    <TeklaVersion>2020.0.0</TeklaVersion>
	  <TargetFramework>net48</TargetFramework>
    <TeklaBinPath>C:\Program Files\Tekla Structures\2020.0\bin\</TeklaBinPath>
  </PropertyGroup>

  <!-- Cấu hình cho Tekla 2025 -->
  <PropertyGroup Condition="$(Configuration.Contains('T25'))">
    <TeklaVersion>2025.0.0</TeklaVersion>
	  <TargetFramework>net48</TargetFramework>
	  <TeklaBinPath>C:\Program Files\Tekla Structures\2025.0\bin\</TeklaBinPath>
  </PropertyGroup>

  <!-- Launch configuration -->
  <PropertyGroup>
    <StartAction>Program</StartAction>
    <StartProgram>$(TeklaBinPath)TeklaStructures.exe</StartProgram>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Tekla.Structures" Version="$(TeklaVersion)" />
    <PackageReference Include="Tekla.Structures.Catalogs" Version="$(TeklaVersion)" />
    <PackageReference Include="Tekla.Structures.Datatype" Version="$(TeklaVersion)" />
    <PackageReference Include="Tekla.Structures.Dialog" Version="$(TeklaVersion)" />
    <PackageReference Include="Tekla.Structures.Drawing" Version="$(TeklaVersion)" />
    <PackageReference Include="Tekla.Structures.Model" Version="$(TeklaVersion)" />
    <PackageReference Include="Tekla.Structures.Plugins" Version="$(TeklaVersion)" />
    <PackageReference Include="TeklaFusion" Version="4.1.32" />
  </ItemGroup>

</Project>
